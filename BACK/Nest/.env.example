# Copier en .env pour le developpement local (deja fait, voir .env).
NODE_ENV=development
PORT=3000

# JWT - en production, definir une vraie valeur secrete (>= 32 caracteres)
# via une variable d'environnement ou un gestionnaire de secrets, jamais en dur.
JWT_ISSUER=ApiRest.Nest
JWT_AUDIENCE=ApiRest.Nest.Clients
JWT_SECRET=Cle-Secrete-Dev-Nest-Changez-Moi-En-Production-1234567890
JWT_EXPIRES_MINUTES=60

# CORS - origines autorisees, separees par des virgules
CORS_ALLOWED_ORIGINS=http://localhost:4200

# API publique tierce utilisee par le module "external"
EXTERNAL_JSONPLACEHOLDER_URL=https://jsonplaceholder.typicode.com/
